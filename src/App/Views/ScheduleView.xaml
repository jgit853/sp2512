<UserControl x:Class="ComplianceAssistant.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="排期提醒" FontWeight="Bold" />
        <TextBlock Text="系统内置频控：每日上限与最短间隔，超限将阻止排期" TextWrapping="Wrap" Foreground="DarkRed" />
        <ListView ItemsSource="{Binding Tasks}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="标题" DisplayMemberBinding="{Binding Task.Title}" />
                    <GridViewColumn Header="排期时间" DisplayMemberBinding="{Binding Task.ScheduledAt}" />
                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Task.Status}" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>
