<UserControl x:Class="ComplianceAssistant.Views.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0 0 8 0">
            <TextBlock Text="草稿（Markdown）" FontWeight="Bold" Margin="0 0 0 4" />
            <TextBox Text="{Binding SelectedTask.CurrentDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="400" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
                <Button Content="套用模板" Command="{Binding ApplyTemplateCommand}" Margin="0 0 8 0" />
                <Button Content="保存版本" Command="{Binding SaveDraftCommand}" Margin="0 0 8 0" />
                <Button Content="质检" Command="{Binding RunChecksCommand}" Margin="0 0 8 0" />
                <Button Content="复制草稿" Command="{Binding CopyDraftCommand}" Margin="0 0 8 0" />
                <Button Content="导出" Command="{Binding ExportDraftCommand}" />
            </StackPanel>
            <TextBlock Text="版本记录" FontWeight="Bold" Margin="0 8 0 4" />
            <ListBox ItemsSource="{Binding SelectedTask.Versions}" DisplayMemberPath="CreatedAt" Height="120" />
            <TextBlock Text="合规提示" FontWeight="Bold" Margin="0 8 0 4" />
            <TextBox Text="{Binding DraftFeedback}" IsReadOnly="True" AcceptsReturn="True" Height="120" />
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="任务信息" FontWeight="Bold" />
            <TextBlock Text="人工确认模式：禁止自动提交和群发" Foreground="DarkRed" TextWrapping="Wrap" />
            <TextBlock Text="平台操作（仅打开/复制/导出，不提供自动提交）" FontWeight="Bold" Margin="0 8 0 4" TextWrapping="Wrap" />
            <Button Content="打开页面" Margin="0 4 0 0" Command="{Binding ExecutePluginActionCommand}" CommandParameter="打开目标页" />
            <Button Content="复制草稿" Margin="0 4 0 0" Command="{Binding ExecutePluginActionCommand}" CommandParameter="复制草稿" />
            <Button Content="导出 Markdown" Margin="0 4 0 0" Command="{Binding ExecutePluginActionCommand}" CommandParameter="导出 Markdown" />
            <TextBlock Text="排期" FontWeight="Bold" Margin="0 8 0 4" />
            <Button Content="排期+提醒" Command="{Binding ScheduleCommand}" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0 4 0 0" />
        </StackPanel>
    </Grid>
</UserControl>
