<Window x:Class="ComplianceAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ComplianceAssistant.ViewModels"
        mc:Ignorable="d"
        Title="合规人机协同内容助手" Height="800" Width="1200" MinWidth="960" MinHeight="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#1E88E5" Padding="12">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="合规人机协同内容发布助手" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="仅支持人工确认，禁止自动提交/群发，所有操作均记录审计日志" Foreground="White" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="viewModels:TabItemViewModel">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding Content}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
